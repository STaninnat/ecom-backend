PORT=8080

# The logger currently writes to ./logs.
LOG_DIR=./logs

# Safe local OAuth fixture. This is only for local startup and mocked/test flows.
GOOGLE_CREDENTIALS_PATH=./etc/dev/google-oauth-dummy.json

DATABASE_URL=postgres://ecom:ecom_password@localhost:5432/ecom_dev?sslmode=disable
MONGO_URI=mongodb://localhost:27017/ecommerce_db
REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=

JWT_SECRET=local-jwt-secret-change-me-32-characters
REFRESH_SECRET=local-refresh-secret-change-me-32-characters

ISSUER=ecom-backend-local
AUDIENCE=ecom-backend-local

APP_MODE=dev
UPLOAD_BACKEND=local
UPLOAD_PATH=./uploads

# Safe dummy/test values. Do not use live keys locally.
STRIPE_SECRET_KEY=sk_test_local_dummy
STRIPE_WEBHOOK_SECRET=whsec_local_dummy

# Required by config even when UPLOAD_BACKEND=local.
S3_BUCKET=local-dev-unused
S3_REGION=us-east-1
